# Copiá este archivo como .env y completá los valores. Nunca subas .env al repositorio.

# PostgreSQL local (docker compose y perfil dev)
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=cambiar-por-una-clave-larga
POSTGRES_PORT=5432

# Clave para cifrar credenciales: 32 bytes en Base64.
# Generala con: openssl rand -base64 32
ENCRYPTION_KEY=

# WhatsApp Cloud API. Guía en docs/05-whatsapp.md
WHATSAPP_VERIFY_TOKEN=inventá-un-texto-largo
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DISPLAY_PHONE_NUMBER=
WHATSAPP_ACCESS_TOKEN=

# Solo para desarrollo: responde un texto fijo hasta que exista la IA.
DEV_ECHO_ENABLED=false
