# Copiá este archivo como .env y completá los valores. Nunca subas .env al repositorio.

# PostgreSQL local (docker compose y perfil dev)
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=cambiar-por-una-clave-larga
POSTGRES_PORT=5432

# Clave para cifrar credenciales: 32 bytes en Base64.
# Generala con: openssl rand -base64 32
ENCRYPTION_KEY=

# WhatsApp Cloud API. Guía en docs/05-whatsapp.md
WHATSAPP_VERIFY_TOKEN=inventá-un-texto-largo
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DISPLAY_PHONE_NUMBER=
WHATSAPP_ACCESS_TOKEN=

# Modelo de IA. Sin clave, cada mensaje se deriva a un operador.
# OpenAI (pago): LLM_API_FORMAT=responses, LLM_BASE_URL=https://api.openai.com/v1, LLM_MODEL=gpt-6.1-terra
# Gemini (gratis para pruebas, sin datos de clientes reales):
LLM_API_FORMAT=chat-completions
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=

# Catálogo de la web de Grenlus (solo lectura). Vacío desactiva la sincronización.
CATALOG_GRENLUS_API_URL=https://grenlus.up.railway.app
